{
  "name": "matam-alshowaikh",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && pnpm --filter @matam/shared build && pnpm --filter @matam/db build && pnpm --filter @matam/api build && pnpm --filter @matam/web build",
    "dev": "pnpm --parallel --filter @matam/api --filter @matam/web dev",
    "dev:api": "pnpm --filter @matam/api dev",

    "dev:web": "pnpm --filter @matam/web dev",
    "migrate:prod": "pnpm --filter @matam/db migrate",
    "start": "node scripts/start-production.mjs"
  }
}
